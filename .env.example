# ============================================================
# APICN004 — Indian Income Tax RAG VoiceBot : configuration
# Copy to `.env` and fill in what you use:  cp .env.example .env
# ============================================================

# ---- API keys (only the provider(s) you actually use) ----
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...

# ---- Answer generator (LLM) ----
# Default is the open-source local SLM via Ollama (fully offline, no API key).
# For a faster cloud option during development you can set LLM_PROVIDER=groq with a
# GROQ_API_KEY (Groq serves open-weight models like Llama 3.3).
LLM_PROVIDER=slm                 # slm | groq | openai | anthropic | openrouter
LLM_MODEL=qwen2.5:3b             # slm: qwen2.5:3b / llama3.2:3b  | groq: llama-3.3-70b-versatile
                                 # openai: gpt-4o-mini | anthropic: claude-3-5-haiku-20241022
                                 # openrouter: meta-llama/llama-3.1-8b-instruct
SLM_BASE_URL=http://localhost:11434/v1   # Ollama's OpenAI-compatible endpoint
SLM_API_KEY=ollama
LLM_MAX_TOKENS=1800
LLM_TEMPERATURE=0.1

# ---- Embeddings (local, offline; no API key needed) ----
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_BATCH=64

# ---- Retrieval / chunking ----
INDEX_DIR=index
DATA_DIR=data
COLLECTION=income_tax
TOP_K=6
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# ---- Speech-to-text ----
STT_PROVIDER=local               # local (faster-whisper) | groq | openai
STT_MODEL=base                   # faster-whisper size: tiny | base | small | medium

# ---- Text-to-speech ----
TTS_PROVIDER=edge                # edge (edge-tts) | piper
TTS_VOICE=en-IN-NeerjaNeural     # edge voice, or a piper .onnx model path
TTS_RATE=+0%                     # edge rate, e.g. +10% / -10%

# ---- Diagnostics ----
SHOW_TIMING=0                    # 1 = print per-stage latency breakdown
